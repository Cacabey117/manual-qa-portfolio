{
  "info": {
    "name": "Manual QA Portfolio - JSONPlaceholder API",
    "description": "Public demo API tests. POST responses are simulated and are not persisted. Run via Postman Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "GET post by ID - 200",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.response.to.be.json);",
              "const body = pm.response.json();",
              "pm.test('Correct post ID', () => pm.expect(body.id).to.eql(1));",
              "pm.test('Title is nonempty', () => pm.expect(body.title).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET posts by user - filtered",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts?userId=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const posts = pm.response.json();",
              "pm.test('Array returned', () => pm.expect(posts).to.be.an('array'));",
              "pm.test('All posts belong to user 1', () => pm.expect(posts.every(p => p.userId === 1)).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST new post - simulated 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"QA portfolio test\",\"body\":\"Sample content\",\"userId\":1}"
        },
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Returned title matches', () => pm.expect(body.title).to.eql('QA portfolio test'));",
              "pm.test('Returned userId matches', () => pm.expect(body.userId).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET missing post - 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET comments for post - relationship",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/posts/1/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const comments = pm.response.json();",
              "pm.test('Comments array', () => pm.expect(comments).to.be.an('array'));",
              "pm.test('All comments belong to post 1', () => pm.expect(comments.every(c => c.postId === 1)).to.be.true);"
            ]
          }
        }
      ]
    }
  ]
}